{
  "name": "qima",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "qima",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.0.0"
      }
    },
    "apps/api": {
      "name": "@qima/api",
      "version": "0.1.0",
      "dependencies": {
        "@qima/config": "0.1.0",
        "@qima/shared": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@qima/web",
      "version": "0.1.0",
      "dependencies": {
        "@qima/config": "0.1.0",
        "@qima/shared": "0.1.0"
      }
    },
    "node_modules/@qima/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@qima/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@qima/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@qima/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@qima/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/config": {
      "name": "@qima/config",
      "version": "0.1.0"
    },
    "packages/domain": {
      "name": "@qima/domain",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@qima/shared",
      "version": "0.1.0"
    }
  }
}
