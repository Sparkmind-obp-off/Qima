# QIMA environment contract (Phase 0 task T0.10)
#
# This file documents the environment surface ONLY. It must never contain real
# credentials, tokens, private keys, or production secrets
# (.codex/IMPLEMENTATION_RULES.md §21 Configuration Rule).
#
# Local development: copy to `.dev.vars` (git-ignored) for `wrangler pages dev`.
# Deployed environments: provision secrets through the Cloudflare secret
# mechanism, never through committed files.

# --- Runtime ---------------------------------------------------------------
# Allowed values: development | staging | production | test
NODE_ENV=development
APP_ENV=development

# Allowed values: debug | info | warn | error
LOG_LEVEL=info

# --- Public URLs -----------------------------------------------------------
# The API is served by the same deployment under /api/v1 and needs no URL.
WEB_URL=http://localhost:3000

# --- Secrets (leave empty in the repository) -------------------------------
# Session/authentication signing secret. Consumed in Phase 2
# (doc 10 §24 Phase 2 — Authentication & Access).
AUTH_SECRET=

# --- Database --------------------------------------------------------------
# QIMA uses the Cloudflare D1 binding `DB` declared in wrangler.jsonc.
# No connection string is stored in the environment.
